/* Rotorcraft UI (translated from the browser game's index.html tokens and ui/styles.css). Cockpit-panel look:
   instrument-grey surfaces, condensed placard headings, B612 body and data faces, avionics magenta for active
   navigation, amber and red only for cautions and warnings. Sizes are in px at a 14 px base (1rem = 14px).
   Menu figures use B612 regular: its digits all share one width, but its points and commas are narrow, where
   B612 Mono gives them a whole digit's width ("3, 000"). The flight HUD keeps the mono face. */
:root {
    --bg: #11181d;
    --panel: #182229;
    --panel-2: #1f2b33;
    --line: #2c3a44;
    --fg: #e6ecef;
    --muted: #93a4ae;
    --nav: #e05cc8;
    --ok: #5fd08a;
    --caution: #f2b53c;
    --warn: #ef5a4c;
    --sky: #7fb6d9;
    -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Regular.ttf");
    font-size: 14px;
    color: var(--fg);
}

.app { flex-grow: 1; background-color: var(--bg); }
.fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hidden { display: none; }
Label, .unity-label { white-space: normal; padding: 0; margin: 0; color: var(--fg); }
.mono { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Regular.ttf"); }
.muted { color: var(--muted); }
.small { font-size: 11.5px; }
.err { color: var(--warn); }
.ok-t { color: var(--ok); }
.caution-t { color: var(--caution); }
.placard { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); letter-spacing: 1.7px; color: var(--muted); font-size: 11px; }
.h1 { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); font-size: 28px; letter-spacing: 2.8px; }
.h1.small-h { font-size: 24px; letter-spacing: 1.2px; }
.h2 { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); font-size: 20px; letter-spacing: 0.8px; }
.h3 { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); font-size: 15.5px; letter-spacing: 1.5px; color: var(--muted); }
.h3.fg { color: var(--fg); }
.p { white-space: normal; max-width: 900px; }
.b { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Bold.ttf"); }

/* ------------------------------------------------------------------------------------------ buttons */
.btn {
    flex-direction: row; align-items: center; justify-content: center;
    min-height: 40px; padding: 6px 14px; margin: 0;
    border-radius: 6px; border-width: 1px; border-color: var(--line); background-color: var(--panel-2);
    -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); letter-spacing: 1.4px; font-size: 13.5px; color: var(--fg);
    -unity-text-align: middle-center; white-space: nowrap;
    transition-property: background-color, border-color; transition-duration: 0.15s;
}
.btn:hover { border-color: var(--muted); }
.btn:focus { border-color: var(--nav); }
.btn:active { background-color: var(--line); }
.btn:disabled { opacity: 0.45; }
.btn.primary { background-color: var(--fg); color: var(--bg); border-color: var(--fg); }
.btn.primary:hover { background-color: #ffffff; }
.btn.primary:active { background-color: #c8d3d8; }
.btn.primary .btn-small { color: #3b4a52; }
.btn.danger { border-color: #8f3c35; color: var(--warn); }
.btn.ghost { background-color: rgba(0, 0, 0, 0); }
.btn.small { min-height: 32px; padding: 3px 10px; font-size: 11.5px; }
.btn > Label { color: var(--fg); -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); }
.btn.primary > Label { color: var(--bg); }
.btn.danger > Label { color: var(--warn); }
.btn-col { flex-direction: column; align-items: stretch; justify-content: center; }
/* stretched to the button's width so a wrapped second line is measured at the width it is drawn at */
.btn-col > Label { -unity-text-align: upper-left; white-space: nowrap; }
.btn > .btn-small { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Regular.ttf"); letter-spacing: 0; color: var(--muted); font-size: 11px; white-space: normal; -unity-text-align: upper-left; margin-top: 2px; }
.btn.primary > .btn-small { color: #3b4a52; }
.row { flex-direction: row; flex-wrap: wrap; align-items: center; }
.row > * { margin-right: 8px; }
.row.between { justify-content: space-between; }
.row.nowrap { flex-wrap: nowrap; }
.stack { flex-direction: column; }
.stack > * { margin-bottom: 10px; }
.stack.tight > * { margin-bottom: 4px; }
.grow { flex-grow: 1; }

/* -------------------------------------------------------------------------------------- main menu */
.menu { flex-grow: 1; flex-direction: row; background-color: var(--bg); }
.menu-map { position: absolute; left: 0; top: 0; right: 0; bottom: 0; opacity: 0.32; -unity-background-scale-mode: scale-and-crop; }
.menu-shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-image: url("project://database/Assets/Rotorcraft/UI/Images/MenuShade.png"); -unity-background-scale-mode: stretch-to-fill; }
.menu-brand { flex-grow: 1; justify-content: flex-end; padding: 28px 28px 34px 34px; }
.menu-logo { width: 168px; height: 168px; margin-bottom: 10px; border-radius: 84px; background-image: url("project://database/Assets/Rotorcraft/UI/Images/logo.jpg"); -unity-background-scale-mode: scale-to-fit; }
.menu-title { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-Bold.ttf"); font-size: 76px; letter-spacing: 4.5px; margin-bottom: 4px; }
.menu-tag { color: var(--muted); max-width: 520px; font-size: 15px; }
.menu-list { width: 400px; justify-content: center; padding: 16px 22px 16px 16px; }
.menu-list > .btn { justify-content: space-between; margin-bottom: 6px; }
.menu-list .btn.big { min-height: 64px; font-size: 17px; flex-direction: column; align-items: stretch; }
.menu-new { align-self: flex-end; margin-top: 6px; }

/* ------------------------------------------------------------------------------- shell with rail */
.shell { flex-grow: 1; flex-direction: row; background-color: var(--bg); }
.rail { width: 196px; padding: 8px 6px; background-color: var(--panel); border-right-width: 1px; border-right-color: var(--line); }
.rail-brand { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-Bold.ttf"); letter-spacing: 2px; font-size: 13px; padding: 4px 9px 10px 9px; color: var(--muted); background-color: rgba(0, 0, 0, 0); border-width: 0; -unity-text-align: middle-left; margin: 0; }
.rail-brand:hover { color: var(--fg); }
.rail-btn { background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 6px; padding: 8px 10px; margin: 0 0 2px 0; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); letter-spacing: 1.4px; font-size: 13px; color: var(--muted); -unity-text-align: middle-left; border-left-width: 3px; border-color: rgba(0, 0, 0, 0); border-top-left-radius: 0; border-bottom-left-radius: 0; }
.rail-btn:hover { color: var(--fg); }
.rail-btn:focus { color: var(--fg); background-color: var(--panel-2); }
.rail-btn.current { background-color: var(--panel-2); color: var(--fg); border-left-color: var(--nav); }
.rail-foot { padding: 6px 10px; color: var(--muted); font-size: 10.5px; }
.content { flex-grow: 1; }
.content .unity-scroll-view__content-container { padding: 14px 22px 34px 22px; }
.page { flex-direction: column; max-width: 1360px; }
.page > * { margin-bottom: 15px; }
.page-head { flex-direction: row; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; }
.subtabs { flex-direction: row; border-bottom-width: 1px; border-bottom-color: var(--line); margin-bottom: 14px; }
.subtab { background-color: rgba(0, 0, 0, 0); border-width: 0; border-bottom-width: 3px; border-bottom-color: rgba(0, 0, 0, 0); border-radius: 0; padding: 7px 13px; margin: 0; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); letter-spacing: 1.4px; color: var(--muted); min-height: 40px; font-size: 13.5px; }
.subtab.current { color: var(--fg); border-bottom-color: var(--nav); }
.subtab:hover { color: var(--fg); }

/* ---------------------------------------------------------------------------------------- surfaces */
.panel { background-color: var(--panel); border-width: 1px; border-color: var(--line); border-radius: 8px; padding: 14px; }
.grid2 { flex-direction: row; flex-wrap: wrap; align-items: stretch; }
.grid2 > * { width: 48.5%; margin-right: 1.5%; margin-bottom: 14px; }
.grid3 > * { width: 32%; margin-right: 2%; margin-bottom: 11px; }
.grid3 { flex-direction: row; flex-wrap: wrap; align-items: stretch; }
.col { flex-direction: column; flex-grow: 1; flex-basis: 0; }
.cols { flex-direction: row; align-items: flex-start; }
.cols > .col { margin-right: 14px; }
.kv-row { flex-direction: row; align-items: flex-start; padding: 2px 0; }
.kv-k { color: var(--muted); font-size: 12px; width: 120px; padding-top: 1px; }
.kv-v { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Regular.ttf"); flex-grow: 1; flex-shrink: 1; font-size: 13px; }
.kv-v.body { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Regular.ttf"); }
.stats { flex-direction: row; flex-wrap: wrap; }
.stat { flex-direction: column; min-width: 120px; flex-grow: 1; margin: 0 10px 6px 0; }
.stat-v { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Regular.ttf"); font-size: 21px; }
.stat-l { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); letter-spacing: 1.7px; font-size: 11px; color: var(--muted); }

/* recommended next action */
.next { flex-direction: row; align-items: center; justify-content: space-between; padding: 14px 16px; border-radius: 8px; background-color: var(--panel-2); border-width: 1px; border-color: var(--line); border-left-width: 4px; border-left-color: var(--nav); }
.next.big { padding: 18px; }
.eyebrow { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); letter-spacing: 2.2px; font-size: 11px; color: var(--nav); }
.next-t { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); font-size: 19px; }
.next.big .next-t { font-size: 22.5px; }

/* status chips */
.chip { flex-direction: row; align-items: center; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); letter-spacing: 1.4px; font-size: 10.5px; padding: 2px 8px; border-radius: 10px; border-width: 1px; border-color: var(--line); color: var(--muted); align-self: flex-start; white-space: nowrap; }
.chip.ok { color: var(--ok); border-color: #3a6b4f; }
.chip.caution { color: var(--caution); border-color: #7a5d24; }
.chip.warn { color: var(--warn); border-color: #7e3631; }
.chip.nav { color: var(--nav); border-color: #74386a; }
/* chips that pick something (leaderboard categories) */
.chip-btn { background-color: rgba(0, 0, 0, 0); min-height: 30px; padding: 4px 12px; margin: 0 6px 6px 0; border-radius: 15px; font-size: 12px; color: #b9c6cc; }
.chip-btn:hover { color: var(--fg); border-color: var(--muted); background-color: var(--panel-2); }
.chip-btn.nav { color: var(--nav); border-color: var(--nav); background-color: rgba(224, 92, 200, 0.12); }

/* lists */
.list > * { margin-bottom: 7px; }
.item { flex-direction: row; align-items: center; padding: 11px 14px; background-color: var(--panel); border-width: 1px; border-color: var(--line); border-radius: 8px; flex-wrap: wrap; }
.item.locked { opacity: 0.72; }
.item-main { flex-grow: 1; flex-shrink: 1; flex-basis: 0; margin-right: 14px; }
.item-title { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); font-size: 16px; letter-spacing: 0.3px; }
.item-meta { flex-direction: row; flex-wrap: wrap; align-items: center; color: var(--muted); font-size: 12px; }
.item-meta > * { margin-right: 7px; }
.item-meta > Label { color: var(--muted); font-size: 12px; }
.reasons { width: 100%; flex-direction: row; flex-wrap: wrap; margin-top: 6px; }
.reason { color: var(--muted); font-size: 11.8px; margin-right: 13px; }
.reason-dot { color: var(--caution); }

/* roadmap strip */
.progress-strip { flex-direction: row; }
.pstep { flex-grow: 1; flex-basis: 0; margin-right: 4px; overflow: hidden; }
.pstep-bar { height: 6px; border-radius: 3px; background-color: var(--line); margin-bottom: 4px; }
.pstep.completed .pstep-bar { background-color: var(--ok); }
.pstep.cur .pstep-bar { background-color: var(--nav); }
.pstep-l { font-size: 9.5px; color: var(--muted); white-space: nowrap; overflow: hidden; -unity-text-overflow-position: end; text-overflow: ellipsis; }
.pstep.cur .pstep-l { color: var(--fg); }

/* forms */
.field { flex-direction: column; margin-bottom: 8px; }
.field-l { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); letter-spacing: 1.4px; font-size: 11px; color: var(--muted); margin-bottom: 4px; }
.txt { margin: 0; }
.txt > .unity-text-field__input, .txt .unity-base-text-field__input { background-color: var(--bg); border-color: var(--line); border-width: 1px; border-radius: 6px; padding: 8px 10px; min-height: 40px; color: var(--fg); -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Regular.ttf"); font-size: 14px; }
.seg { flex-direction: row; flex-wrap: wrap; border-width: 1px; border-color: var(--line); border-radius: 6px; overflow: hidden; align-self: flex-start; }
.seg-btn { background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0; margin: 0; padding: 6px 11px; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); letter-spacing: 1.1px; color: var(--muted); min-height: 38px; font-size: 13px; }
.seg-btn:hover { color: var(--fg); }
.seg-btn.on { background-color: var(--fg); color: var(--bg); }
.check { flex-direction: row; align-items: center; padding: 6px 2px; border-bottom-width: 1px; border-bottom-color: var(--line); }
.check-box { width: 20px; height: 20px; border-radius: 4px; border-width: 1px; border-color: var(--muted); margin-right: 9px; align-items: center; justify-content: center; }
.check.on .check-box { background-color: var(--ok); border-color: var(--ok); }
.check-tick { color: var(--bg); -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Bold.ttf"); font-size: 13px; }
.check-l { flex-shrink: 1; flex-grow: 1; }
.slider { margin: 0; }
.slider .unity-base-slider__tracker { background-color: var(--bg); border-color: var(--line); height: 6px; margin-top: -3px; border-radius: 3px; }
.slider .unity-base-slider__dragger { background-color: var(--nav); border-width: 0; width: 16px; height: 16px; border-radius: 8px; margin-top: -8px; }
.slider .unity-base-slider__dragger-border { display: none; }

/* bars */
.bar { height: 8px; border-radius: 4px; background-color: var(--bg); overflow: hidden; flex-grow: 1; }
.bar-fill { height: 100%; background-color: var(--ok); }
.bar.c .bar-fill { background-color: var(--caution); }
.bar.w .bar-fill { background-color: var(--warn); }
.scorerow { flex-direction: row; align-items: center; margin-bottom: 4px; }
.scorerow-l { width: 170px; font-size: 13px; }
.scorerow-v { width: 52px; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Regular.ttf"); -unity-text-align: middle-right; }
.bar.in-row { margin: 0 9px; }

/* briefing */
.metar { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612Mono-Regular.ttf"); background-color: var(--bg); border-width: 1px; border-color: var(--line); padding: 7px 10px; border-radius: 6px; font-size: 12.5px; }
.footerbar { flex-direction: row; justify-content: space-between; align-items: center; flex-wrap: wrap; padding: 10px 0; border-top-width: 1px; border-top-color: var(--line); background-color: var(--bg); }
.obj-row { flex-direction: row; align-items: flex-start; margin-bottom: 4px; }
.obj-n { width: 22px; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612Mono-Regular.ttf"); color: var(--muted); }
.obj-l { flex-grow: 1; flex-shrink: 1; font-size: 13px; }
.obj-ph { color: var(--muted); font-size: 10.5px; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); letter-spacing: 1.1px; margin-left: 8px; }
.map-box { height: 180px; border-radius: 6px; overflow: hidden; background-color: #0d1418; }

/* outcome banner */
.outcome { padding: 14px 17px; border-radius: 8px; border-width: 1px; border-color: var(--line); flex-direction: row; justify-content: space-between; align-items: center; flex-wrap: wrap; background-color: var(--panel); }
.outcome-big { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-Bold.ttf"); font-size: 31px; letter-spacing: 3.7px; }
.outcome.pass { border-color: #3f7c58; }
.outcome.pass .outcome-big { color: var(--ok); }
.outcome.fail { border-color: #8f3c35; }
.outcome.fail .outcome-big { color: var(--warn); }
.outcome.neutral .outcome-big { color: var(--caution); }

/* tables */
.table { flex-direction: column; }
.tr { flex-direction: row; border-bottom-width: 1px; border-bottom-color: var(--line); padding: 6px 2px; align-items: center; }
.th { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); letter-spacing: 1.4px; font-size: 10.5px; color: var(--muted); }
.td { font-size: 12.5px; padding-right: 8px; flex-shrink: 1; }
.td.num { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Regular.ttf"); -unity-text-align: middle-right; }
.th.td.num { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); font-size: 10.5px; }

/* quiz */
.q { padding: 11px 0; border-bottom-width: 1px; border-bottom-color: var(--line); }
.q > * { margin-bottom: 6px; }
.opt { background-color: var(--bg); border-width: 1px; border-color: var(--line); border-radius: 6px; padding: 8px 10px; min-height: 40px; margin: 0 0 5px 0; -unity-text-align: middle-left; white-space: normal; color: var(--fg); -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Regular.ttf"); font-size: 13.5px; border-left-width: 1px; }
.opt:hover { border-color: var(--muted); }
.opt.on { border-color: var(--sky); border-left-width: 4px; }
.opt.right { border-color: var(--ok); border-left-width: 4px; }
.opt.wrong { border-color: var(--warn); border-left-width: 4px; }

.spark { flex-direction: row; align-items: flex-end; height: 22px; min-width: 40px; }
.spark-i { width: 6px; margin-right: 2px; background-color: var(--muted); border-radius: 1px; opacity: 0.8; }
.spark-i.p { background-color: var(--ok); }
.spark-i.x { background-color: var(--warn); }

/* aircraft and kit pickers */
.acpick { flex-direction: column; align-items: flex-start; padding: 13px 14px; border-radius: 8px; border-width: 1px; border-color: var(--line); background-color: var(--panel); margin: 0; -unity-text-align: upper-left; white-space: normal; }
.acpick.on { border-color: var(--fg); background-color: var(--panel-2); }
.acpick:hover { background-color: var(--panel-2); border-color: var(--muted); }
.acpick:focus, .acpick:active, .acpick.on:hover { background-color: var(--panel-2); border-color: var(--fg); }
.acpick-nm { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-Bold.ttf"); font-size: 18px; letter-spacing: 0.5px; }
/* cards in a grid keep its spacing (a card on its own has no margin); one row of aircraft, all the same height */
.grid3 > .acpick { width: 32.3%; margin: 0 1% 11px 0; }
.acrow { flex-direction: row; align-items: stretch; margin-left: -5px; margin-right: -5px; }
.acrow > .acpick { flex-grow: 1; flex-basis: 0; margin: 0 5px; }
.kitrow { flex-direction: row; align-items: flex-start; padding: 8px 10px; border-width: 1px; border-color: var(--line); border-radius: 6px; background-color: var(--panel-2); margin: 0 0 6px 0; }
.kitrow.na { opacity: 0.45; }
.kitrow-main { flex-grow: 1; flex-shrink: 1; margin: 0 10px; }

/* ------------------------------------------------------------------------------------- loading */
.loading { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: var(--bg); transition-property: opacity; transition-duration: 0.45s; }
.loading-glow { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-image: url("project://database/Assets/Rotorcraft/UI/Images/LoadingGlow.png"); -unity-background-scale-mode: stretch-to-fill; }
.loading.leaving { opacity: 0; }
.loading-logo { width: 240px; height: 240px; border-radius: 120px; background-image: url("project://database/Assets/Rotorcraft/UI/Images/logo.jpg"); -unity-background-scale-mode: scale-to-fit; margin-bottom: 20px; }
.loading-what { align-items: center; margin-bottom: 20px; }
.loading-t { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); font-size: 28px; letter-spacing: 0.5px; -unity-text-align: middle-center; }
.loading-bar { width: 340px; height: 4px; border-radius: 2px; background-color: var(--line); overflow: hidden; margin-bottom: 20px; }
.loading-bar-fill { height: 100%; border-radius: 2px; background-color: var(--fg); width: 0; }
.loading-tip { width: 560px; align-items: center; padding: 14px 17px; border-width: 1px; border-color: var(--line); border-radius: 8px; background-color: rgba(24, 34, 41, 0.75); }
.loading-tip > * { margin-bottom: 6px; }
.loading-tip-t { color: #d6dee2; -unity-text-align: middle-center; align-self: stretch; white-space: normal; }

/* ----------------------------------------------------------------------------------- flight HUD */
.hud { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612Mono-Regular.ttf"); color: #f2f5f6; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.7); }
.hud Label { color: #f2f5f6; }
.hud-top { position: absolute; left: 10px; right: 10px; top: 6px; flex-direction: row; justify-content: space-between; align-items: flex-start; }
.readouts { flex-direction: row; }
.ro { background-color: rgba(10, 14, 17, 0.62); border-width: 1px; border-color: rgba(255, 255, 255, 0.08); border-radius: 5px; padding: 2px 7px 3px 7px; min-width: 62px; margin-right: 3px; align-items: flex-end; }
.ro-l { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); font-size: 10px; letter-spacing: 1.4px; color: #a9b6bd; align-self: flex-start; }
.ro-v { font-size: 17px; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612Mono-Regular.ttf"); }
.ro.caution .ro-v { color: var(--caution); }
.ro.warn .ro-v { color: var(--warn); }
.ro.ok .ro-v { color: var(--ok); }
.hud-btns { flex-direction: row; }
.hb { min-width: 44px; height: 38px; padding: 0 9px; border-radius: 6px; border-width: 1px; border-color: rgba(255, 255, 255, 0.14); background-color: rgba(10, 14, 17, 0.62); -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); letter-spacing: 1.2px; font-size: 12px; color: #f2f5f6; margin: 0 0 0 4px; }
.hb:hover { border-color: rgba(255, 255, 255, 0.4); }
.hb.on { background-color: rgba(230, 236, 239, 0.88); color: #11181d; }
.hb.start { border-color: var(--ok); color: var(--ok); }
.hb.ap.on { background-color: rgba(77, 208, 140, 0.9); color: #0d1a12; border-color: rgb(77, 208, 140); }
.hb.mic.on { background-color: rgba(255, 106, 92, 0.9); color: #160805; }
.hb:disabled { opacity: 0.45; }
.hbadge { position: absolute; top: -6px; right: -6px; min-width: 18px; height: 18px; border-radius: 9px; background-color: var(--warn); color: #ffffff; font-size: 11px; -unity-text-align: middle-center; padding: 0 4px; }
.objective { position: absolute; top: 82px; left: 10px; max-width: 380px; background-color: rgba(10, 14, 17, 0.62); border-radius: 6px; padding: 6px 9px; border-left-width: 3px; border-left-color: var(--nav); -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Regular.ttf"); }
.objective.idle { border-left-color: var(--caution); }
.objective-ph { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); font-size: 10.5px; letter-spacing: 1.7px; color: var(--nav); }
.objective.idle .objective-ph { color: var(--caution); }
.objective-lb { font-size: 13px; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Regular.ttf"); }
.objective-dt { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612Mono-Regular.ttf"); font-size: 12px; color: #c4ced3; }
.objective-pg { height: 3px; background-color: rgba(255, 255, 255, 0.12); margin-top: 4px; border-radius: 2px; overflow: hidden; }
.objective-pg-fill { height: 100%; background-color: var(--nav); }
.navbox { position: absolute; top: 52px; right: 10px; background-color: rgba(10, 14, 17, 0.62); border-radius: 6px; padding: 5px 9px; align-items: flex-end; min-width: 160px; }
.navbox-nm { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Regular.ttf"); font-size: 12px; color: var(--nav); }
.navbox-bd { font-size: 15px; }
.navbox-al { font-size: 11px; color: #c4ced3; }
.annun { position: absolute; top: 54px; left: 0; right: 0; flex-direction: row; justify-content: center; }
.ann { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-Bold.ttf"); letter-spacing: 1.4px; font-size: 12px; padding: 3px 8px; border-radius: 3px; background-color: var(--warn); color: #1a0705; margin: 0 2px; }
.ann.c { background-color: var(--caution); color: #1d1405; }
.radio { position: absolute; bottom: 8px; left: 27%; right: 27%; flex-direction: column; justify-content: flex-end; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Regular.ttf"); }
.msg { background-color: rgba(10, 14, 17, 0.7); border-radius: 5px; padding: 4px 8px; margin-top: 3px; flex-direction: row; flex-wrap: wrap; border-left-width: 3px; border-left-color: rgba(0, 0, 0, 0); transition-property: opacity, translate; transition-duration: 0.25s; }
.msg.new { opacity: 0; translate: 0 4px; }
.msg.caution { border-left-color: var(--caution); }
.msg.warning { border-left-color: var(--warn); }
.msg.good { border-left-color: var(--ok); }
.msg-from { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); letter-spacing: 1.2px; font-size: 10.5px; color: #a9b6bd; margin-right: 6px; padding-top: 2px; }
.msg-t { font-size: 12.5px; flex-shrink: 1; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Regular.ttf"); }
.agl { position: absolute; left: 0; right: 0; top: 43%; align-items: center; font-size: 13px; color: #e6ecef; opacity: 0.9; }
.agl-tag { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); letter-spacing: 1.4px; font-size: 10px; color: #a9b6bd; }
.center-card { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(8, 11, 13, 0.55); padding: 16px; }
.card { background-color: var(--panel); border-width: 1px; border-color: var(--line); border-radius: 10px; padding: 15px 17px; width: 460px; max-height: 100%; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Regular.ttf"); }
.card > * { margin-bottom: 11px; }
.banner { position: absolute; left: 0; right: 0; top: 30%; align-items: center; }
.banner-box { background-color: rgba(10, 14, 17, 0.82); border-width: 1px; border-color: var(--ok); border-radius: 8px; padding: 10px 14px; flex-direction: row; align-items: center; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Regular.ttf"); }
.banner-box.fail { border-color: var(--warn); }
.banner-box > * { margin-right: 14px; }
.panel-overlay { position: absolute; left: 50%; bottom: 8px; width: 780px; height: 312px; translate: -50% 0; background-color: rgba(12, 16, 19, 0.88); border-width: 1px; border-color: rgba(255, 255, 255, 0.1); border-radius: 10px; }
.map-overlay { position: absolute; right: 10px; top: 52px; width: 440px; height: 330px; border-radius: 8px; overflow: hidden; border-width: 1px; border-color: rgba(255, 255, 255, 0.12); background-color: #0d1418; }
.switches { position: absolute; left: 50%; top: 92px; translate: -50% 0; flex-direction: row; flex-wrap: wrap; justify-content: center; max-width: 640px; background-color: rgba(10, 14, 17, 0.72); border-width: 1px; border-color: rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 6px; }
.sw { flex-direction: row; align-items: center; height: 34px; padding: 0 9px; border-radius: 5px; border-width: 1px; border-color: rgba(255, 255, 255, 0.14); background-color: #1a2126; color: #c9d3d8; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); letter-spacing: 1.2px; font-size: 12px; margin: 2px; }
.sw-lamp { width: 8px; height: 8px; border-radius: 4px; background-color: #3a4349; margin-right: 6px; }
.sw.on { color: #ffffff; border-color: rgba(95, 208, 138, 0.55); }
.sw.on .sw-lamp { background-color: var(--ok); }
.sw-kbd { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612Mono-Regular.ttf"); font-size: 10px; color: #7f8d94; border-width: 1px; border-color: #3a4349; border-radius: 3px; padding: 0 3px; margin-left: 6px; }
.swinfo { width: 100%; -unity-text-align: middle-center; font-size: 11px; color: #a9b6bd; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Regular.ttf"); }
.crewbar { position: absolute; right: 10px; top: 56px; flex-direction: row; flex-wrap: wrap; justify-content: flex-end; max-width: 320px; align-items: center; }
.crewbar .hb { margin: 0 0 4px 4px; }
.apstat { width: 100%; -unity-text-align: middle-right; font-size: 11px; color: #7fe0a8; }
.decision { position: absolute; left: 50%; top: 22%; translate: -50% 0; width: 560px; background-color: rgba(10, 14, 17, 0.9); border-width: 1px; border-color: var(--caution); border-radius: 10px; padding: 11px 13px; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Regular.ttf"); }
.decision > * { margin-bottom: 8px; }
.decision-q { font-size: 14px; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Regular.ttf"); }
.decision .btn { -unity-text-align: middle-left; justify-content: flex-start; white-space: normal; margin-bottom: 6px; }
.hood { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(18, 21, 24, 0.97); align-items: center; }
.hood-l { margin-top: 30%; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); letter-spacing: 2.4px; font-size: 11px; color: #5d676d; }
.hintcard { position: absolute; left: 50%; top: 168px; translate: -50% 0; width: 480px; background-color: rgba(10, 14, 17, 0.88); border-width: 1px; border-color: var(--nav); border-radius: 8px; padding: 9px 12px; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Regular.ttf"); }
.hintcard > * { margin-bottom: 5px; }
.hintcard-ttl { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); letter-spacing: 1.9px; font-size: 11px; color: var(--nav); }
.hintcard-txt { font-size: 13px; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Regular.ttf"); }
.trimchip { position: absolute; top: 50px; left: 10px; flex-direction: row; align-items: center; background-color: rgba(17, 24, 29, 0.82); border-width: 1px; border-color: var(--nav); border-radius: 4px; padding: 4px 10px; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); letter-spacing: 1.4px; font-size: 12px; margin: 0; }
.trimchip-b { color: var(--nav); -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-Bold.ttf"); margin-right: 8px; }
.trimchip-s { color: var(--muted); font-size: 11px; }
.pause-card .btn { margin-bottom: 7px; }

/* pre-flight checks */
.preflight { position: absolute; top: 82px; left: 10px; width: 390px; background-color: rgba(10, 14, 17, 0.88); border-width: 1px; border-color: var(--line); border-left-width: 3px; border-left-color: var(--ok); border-radius: 8px; padding: 9px 11px; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Regular.ttf"); }
.preflight > * { margin-bottom: 7px; }
.pf-head { flex-direction: row; justify-content: space-between; align-items: flex-end; }
.pf-title { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); letter-spacing: 1.7px; font-size: 14px; }
.pf-count { font-size: 12px; color: var(--ok); }
.pf-li { flex-direction: row; align-items: center; margin-bottom: 5px; }
.pf-ic { width: 20px; color: var(--muted); -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Bold.ttf"); -unity-text-align: middle-center; }
.pf-li.done .pf-ic { color: var(--ok); }
.pf-tx { flex-grow: 1; flex-shrink: 1; }
.pf-b { font-size: 13px; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Bold.ttf"); }
.pf-li.done .pf-b { color: #c4ced3; }
.pf-s { font-size: 11.5px; color: var(--muted); }
.hotspot { position: absolute; flex-direction: row; align-items: center; background-color: rgba(0, 0, 0, 0); border-width: 0; padding: 4px; margin: 0; }
.hotspot-dot { width: 22px; height: 22px; border-radius: 11px; border-width: 2px; border-color: var(--ok); background-color: rgba(95, 208, 138, 0.25); margin-right: 6px; transition-property: scale; transition-duration: 0.8s; }
.hotspot-dot.pulse { scale: 1.25 1.25; }
.hotspot-l { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); letter-spacing: 1.2px; font-size: 12px; background-color: rgba(10, 14, 17, 0.78); padding: 2px 7px; border-radius: 4px; }

/* crew tablet */
.tablet { position: absolute; right: 12px; top: 56px; bottom: 12px; width: 720px; }
.tab-bezel { flex-grow: 1; background-color: #0b0e10; border-width: 10px; border-color: #23292d; border-radius: 18px; overflow: hidden; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Regular.ttf"); }
.tab-status { flex-direction: row; align-items: center; padding: 5px 10px; background-color: #151b1f; border-bottom-width: 1px; border-bottom-color: #263038; }
.tab-status > Label { font-size: 12px; color: #b9c6cc; margin-right: 13px; }
.tab-status .earn { color: var(--ok); margin-left: auto; margin-right: 0; }
.tab-tabs { flex-direction: row; padding: 5px 7px 0 7px; background-color: #11161a; }
.tab-tab { background-color: rgba(0, 0, 0, 0); border-width: 0; border-bottom-width: 2px; border-bottom-color: rgba(0, 0, 0, 0); border-radius: 0; padding: 6px 11px; margin: 0; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-SemiBold.ttf"); letter-spacing: 1.4px; font-size: 13px; color: var(--muted); flex-direction: row; }
.tab-tab.current { color: var(--fg); border-bottom-color: var(--caution); }
.tab-badge { margin-left: 5px; min-width: 17px; padding: 0 4px; border-radius: 9px; background-color: var(--warn); color: #ffffff; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612Mono-Regular.ttf"); font-size: 11px; -unity-text-align: middle-center; }
.tab-screen { flex-grow: 1; background-color: #0e1316; }
.tab-screen .unity-scroll-view__content-container { padding: 10px 11px; }
.tab-msg { padding: 6px 9px; border-width: 1px; border-color: var(--caution); border-radius: 6px; color: var(--caution); margin-bottom: 7px; }
.tab-foot { flex-direction: row; justify-content: space-between; align-items: center; padding: 6px 10px; background-color: #151b1f; border-top-width: 1px; border-top-color: #263038; }
.call { border-width: 1px; border-color: #2a353d; border-left-width: 4px; border-left-color: var(--sky); border-radius: 7px; background-color: #131a1f; margin-bottom: 7px; }
.call.p1 { border-left-color: var(--warn); }
.call.p2 { border-left-color: var(--caution); }
.call-head { flex-direction: row; align-items: center; background-color: rgba(0, 0, 0, 0); border-width: 0; padding: 8px 9px; margin: 0; }
.call-ttl { flex-grow: 1; flex-shrink: 1; margin: 0 9px; }
.call-ttl-b { font-size: 14px; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Bold.ttf"); }
.call-ttl-s { color: var(--muted); font-size: 12px; }
.call-meta { align-items: flex-end; }
.call-meta > Label { font-size: 12px; color: #c7d2d7; }
.call-body { padding: 0 11px 9px 11px; }
.call-body > * { margin-bottom: 5px; }
.prio { min-width: 30px; -unity-text-align: middle-center; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612Mono-Regular.ttf"); font-size: 12px; padding: 2px 5px; border-radius: 4px; background-color: var(--sky); color: #0b0e10; }
.prio.p1 { background-color: var(--warn); color: #ffffff; }
.prio.p2 { background-color: var(--caution); }
.navline { padding: 5px 8px; border-radius: 5px; background-color: rgba(224, 92, 200, 0.12); color: var(--nav); font-size: 12.5px; }
.step { flex-direction: row; margin-bottom: 4px; }
.step-ic { width: 20px; color: var(--muted); }
.step-tx { flex-grow: 1; flex-shrink: 1; color: var(--muted); }
.step.active .step-tx { color: var(--fg); }
.step.active .step-ic { color: var(--nav); }
.step.complete .step-ic { color: var(--ok); }
.step.failed .step-ic { color: var(--warn); }
.step-s { -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Regular.ttf"); color: #c4ced3; font-size: 11.5px; }
.tab-map { flex-grow: 1; min-height: 300px; border-radius: 6px; background-color: #0d1418; }

/* controller set-up */
.meter { width: 110px; height: 10px; border-radius: 5px; background-color: var(--bg); border-width: 1px; border-color: var(--line); overflow: hidden; }
.meter-fill { position: absolute; top: 0; bottom: 0; background-color: var(--nav); }
.meter-mid { position: absolute; left: 50%; top: 0; bottom: 0; width: 1px; background-color: var(--muted); }
.padlamp { width: 12px; height: 12px; border-radius: 6px; background-color: var(--line); }
.padlamp.on { background-color: var(--ok); }

/* pilot area */
.login-badge { width: 54px; height: 54px; border-radius: 27px; align-items: center; justify-content: center; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/BarlowCondensed-Bold.ttf"); font-size: 28px; background-color: var(--panel-2); border-width: 1px; border-color: var(--line); color: var(--sky); }
.rankpips { flex-direction: row; }
.rankpip { width: 8px; height: 18px; border-radius: 2px; background-color: var(--line); margin-right: 3px; }
.rankpip.on { background-color: var(--caution); }
.rankpips.l7 .rankpip.on { background-color: var(--nav); }
.cloudline { flex-direction: row; align-items: center; flex-wrap: wrap; padding: 6px 9px; }
.cloud-dot { width: 8px; height: 8px; border-radius: 4px; background-color: var(--line); margin-right: 6px; }
.cloud-dot.on { background-color: var(--ok); }
.lb-row { -unity-text-align: middle-left; justify-content: flex-start; border-radius: 0; min-height: 36px; }
.lb-row.me { background-color: rgba(224, 92, 200, 0.14); }
.lb-pos { width: 40px; -unity-font-definition: url("project://database/Assets/Rotorcraft/UI/Fonts/B612-Bold.ttf"); }
.lb-row.top1 .lb-pos { color: #f2c94c; }
.lb-row.top2 .lb-pos { color: #c9d1d6; }
.lb-row.top3 .lb-pos { color: #d79a5e; }

ScrollView { flex-grow: 1; }
.unity-scroller--vertical { width: 10px; }
.unity-scroller--vertical .unity-base-slider__tracker { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.unity-scroller--vertical .unity-base-slider__dragger { background-color: #2c3a44; border-width: 0; border-radius: 4px; width: 6px; left: 2px; }
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }
